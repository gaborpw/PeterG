# Only needed if the app cannot work out your Mac's address by itself.
# Library will say "could not find the API host" when that happens.
#
# Copy this to app/.env and set it to your Mac's LAN IP — the same address
# Expo prints as "Metro: exp://192.168.x.x:8081", with port 8080.
#
# EXPO_PUBLIC_ is not a naming convention: Expo only inlines variables with
# that prefix into the bundle. Restart Expo after changing this.
EXPO_PUBLIC_API_URL=http://192.168.0.200:8080
