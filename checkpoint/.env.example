# Copy to .env and fill in. .env is git-ignored; never commit it.

# Matches docker-compose.yml.
DATABASE_URL=postgres://checkpoint:checkpoint@localhost:5432/checkpoint?sslmode=disable

CHECKPOINT_ADDR=:8080

# Optional. Without these the catalogue sync is disabled and the API still runs.
# Created at https://dev.twitch.tv/console/apps — IGDB authenticates through Twitch.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
